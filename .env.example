# HealthStream Configuration Template
PORT=3000
NODE_ENV=development

# Database Connection (PostgreSQL / Supabase / Cloud SQL)
DATABASE_URL=
POSTGRES_URL=
DB_SSL=
PGSSLMODE=

# Admin User Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
