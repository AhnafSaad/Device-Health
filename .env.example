# Server & Network Configuration
PORT=3000
NODE_ENV=development

# Session & Security
SESSION_SECRET=healthstream-noc-session-secret-key-32chars
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminpassword123

# Database Connection (PostgreSQL / AI Studio Cloud SQL)
# Leave empty for seamless in-memory fallback
DATABASE_URL=
POSTGRES_URL=
DB_SSL=false
PGSSLMODE=disable

# SNMP Telemetry Polling Schedule (Cron format, e.g. every 1 minute)
SNMP_POLL_CRON=*/1 * * * *

# AI Capabilities (Optional)
GEMINI_API_KEY=
