# Server configuration
PORT=3000
NODE_ENV=production
SESSION_SECRET=healthstream-noc-session-secret-key-32chars

# Database configuration (PostgreSQL)
# For local docker-compose setup: postgresql://postgres:postgres@postgres:5432/healthstream?sslmode=disable
# For external cloud database (Supabase/RDS/etc): postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/healthstream?sslmode=disable
POSTGRES_URL=postgresql://postgres:postgres@postgres:5432/healthstream?sslmode=disable

# Initial admin credentials (seeded upon first run)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin0223#

# SNMP Background Poller Cron schedule (e.g. every minute: */1 * * * *)
SNMP_POLL_CRON="*/1 * * * *"