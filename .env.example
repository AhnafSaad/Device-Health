# NOC Fleet Monitor Environment Configuration

# Database Connection (PostgreSQL)
DATABASE_URL=postgres://user:password@localhost:5432/noc_fleet
POSTGRES_URL=postgres://user:password@localhost:5432/noc_fleet

# Application Port
PORT=3000

# Gemini AI / LLM Integration
GEMINI_API_KEY=

# Initial Administrator Seed Credentials
# NOTE: only used to seed the very first user on first startup — after that, manage users from the Manage Users screen
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminpassword123

# HTTP Session Security Secret
SESSION_SECRET=super-secret-session-encryption-key-change-in-production

# Background SNMP Polling Schedule (node-cron expression)
# Default: "*/1 * * * *" (polls all network nodes once every minute)
# Slower example: "*/5 * * * *" (polls once every 5 minutes)
SNMP_POLL_CRON="*/1 * * * *"
