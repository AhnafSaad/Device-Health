# Server & Port Configuration
PORT=3000
NODE_ENV=development

# Session Configuration
SESSION_SECRET=healthstream-noc-session-secret-key-32chars

# Admin User Credentials (Initial Seed)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminpassword123

# PostgreSQL Database (Optional - in-memory fallback active if omitted)
DATABASE_URL=
POSTGRES_URL=

# SNMP Polling Configuration (Cron format)
SNMP_POLL_CRON=*/1 * * * *

# Gemini API Key (if AI capabilities are enabled)
GEMINI_API_KEY=
